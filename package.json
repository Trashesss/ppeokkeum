{
  "name": "ppeokkeum",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fishing/client",
    "build": "npm run build -w @fishing/client",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p apps/client",
    "assets:characters": "node tools/build-character-assets.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
